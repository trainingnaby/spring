<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.5</version>
		<relativePath />
	</parent>

	<groupId>com.formation</groupId>
	<artifactId>8-fil-rouge-spring-data-jpa</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>8-fil-rouge-spring-data-jpa-corrige</name>
	<description>Application fil rouge Spring Boot + Spring Data JPA -
		génération de duplicatas d'impôts</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<!-- MVC REST + MVC Thymeleaf + Tomcat embarqué + Jackson + validation
		MVC de base -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Moteur de templates HTML côté serveur. Boot configure
		automatiquement le ViewResolver Thymeleaf. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- Bean Validation : @NotBlank, @Min, @Max, @Valid... -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Spring AOP + AspectJ Weaver pour conserver l'aspect de
		normalisation du userId. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>

		<!-- Base H2 embarquée pour le TP. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Tests Boot : JUnit 5, Spring Test, MockMvc, AssertJ, Mockito... -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Spring Data JPA : Repository, EntityManager, Hibernate et
		transaction management. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
